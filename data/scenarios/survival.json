{
    "id": "survival",
    "name": "Survival",
    "description": "Survive 30 days on a hostile alien world. Fend off alien attacks and keep your colonists alive.",
    "enabled": true,
    "hostile_max": 20,
    "spawn_rules": {
        "alien_grunt": {
            "spawn_rate": 40,
            "light_min": 0,
            "tiles": ["regolith", "dirt"],
            "min_z": 5,
            "max_z": 5
        },
        "alien_scout": {
            "spawn_rate": 30,
            "light_min": 0,
            "tiles": ["regolith", "dirt"],
            "min_z": 5,
            "max_z": 5
        },
        "alien_brute": {
            "spawn_rate": 10,
            "light_min": 0,
            "tiles": ["regolith", "dirt"],
            "min_z": 5,
            "max_z": 5
        },
        "critter": {
            "spawn_rate": 70,
            "light_min": 0,
            "tiles": ["regolith", "dirt"],
            "min_z": 4,
            "max_z": 6
        }
    },
    "lighting": {
        "mode": "day_night"
    },
    "win_conditions": {
        "rules": [
            {
                "id": "survive_30_days",
                "trigger": "days_survived",
                "threshold": 30,
                "op": "gte",
                "result": "win",
                "outcome": "victory",
                "message": "Your colony survived 30 days on this hostile world. Victory!"
            },
            {
                "id": "all_colonists_dead",
                "trigger": "colonist_eliminated",
                "threshold": 0,
                "op": "eq",
                "result": "lose",
                "outcome": "defeat",
                "message": "All colonists have been eliminated. The colony has fallen."
            }
        ]
    }
}
