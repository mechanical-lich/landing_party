{
    "id": "earth_like",
    "name": "Earth-like Colony",
    "description": "An Earth-like world of forests, plains, deserts, and tundra. Establish a colony and survive the local fauna.",
    "enabled": true,
    "setup_scripts": ["data/scripts/scenarios/earth_setup.basic"],
    "hostile_max": 80,
    "spawn_rules": {
        "critter": {
            "spawn_rate": 70,
            "light_min": 0,
            "tiles": ["grass", "dirt_floor", "regolith"],
            "min_z": 4,
            "max_z": 6
        }
    },
    "lighting": { "mode": "day_night" },
    "world": {
        "terrain": "planet",
        "biome_map": {
            "type": "perlin_temp_humidity",
            "scale": 80,
            "biomes": ["tundra", "forest", "plains", "desert"]
        },
        "features": [
            { "kind": "ore_vein", "count": 30, "params": { "tile": "ore_deposit", "radius": 3 } },
            { "kind": "ore_vein", "count": 15, "params": { "tile": "crystal_vein", "radius": 2 } },
            { "kind": "radiation_pocket", "count": 2, "biome": "desert", "params": { "peak": 160, "radius": 4 } },
            { "kind": "scatter_entity", "count": 80, "biome": "forest", "params": { "blueprint": "alien_flora", "kind": "surface" } },
            { "kind": "scatter_tile", "count": 80,  "biome": "tundra", "params": { "tile": "ice", "kind": "surface" } },
            { "kind": "lava_lake",   "count": 12,  "biome": "tundra", "params": { "tile": "ice", "radius": 3 } },
            { "kind": "lava_lake",   "count": 4,   "biome": "tundra", "params": { "tile": "ice", "radius": 5 } }
        ]
    },
    "win_conditions": {
        "rules": [
            {
                "id": "survive_30_days",
                "trigger": "days_survived",
                "threshold": 30,
                "op": "gte",
                "result": "win",
                "outcome": "victory",
                "message": "Your colony has thrived for 30 days. Victory!"
            },
            {
                "id": "all_colonists_dead",
                "trigger": "colonist_eliminated",
                "threshold": 0,
                "op": "eq",
                "result": "lose",
                "outcome": "defeat",
                "message": "All colonists have perished."
            }
        ]
    }
}
