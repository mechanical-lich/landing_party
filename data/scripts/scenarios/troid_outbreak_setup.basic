function on_setup()
    add_message("Day 1. Touchdown. Bioscanners are picking up life signs beneath the surface.")

    n = get_region_count("starting_asteroid")
    if n > 0 then
        sx = get_region_x("starting_asteroid", 0)
        sy = get_region_y("starting_asteroid", 0)
        sz = get_region_z("starting_asteroid", 0)
    else
        sx = get_flag("start_x")
        sy = get_flag("start_y")
        sz = get_flag("start_z")
    endif

    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 3, sy - 3, sz, 7, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 3, sz, faction)
    spawn_entity_owned("storage_locker", sx - 2, sy - 2, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 2, sy - 2, sz, sname)

    # Seed troid eggs in caves and deep rock floors
    eggs_spawned = 0
    for attempt = 1 to 400
        if eggs_spawned < 8 then
            found = find_cave_tile()
            if found = 1 then
                cx = get_cave_x()
                cy = get_cave_y()
                cz = get_cave_z()
                ddx = cx - sx
                ddy = cy - sy
                d2 = ddx * ddx + ddy * ddy
                if d2 > 64 then
                    spawn_entity("troid_egg", cx, cy, cz)
                    eggs_spawned = eggs_spawned + 1
                endif
            endif
        endif
    next attempt

    # Spawn a few adults already on the surface to signal the outbreak is underway
    adults_spawned = 0
    for attempt = 1 to 300
        if adults_spawned < 3 then
            found = find_open_tile(sz)
            if found = 1 then
                ox = get_open_x()
                oy = get_open_y()
                ddx = ox - sx
                ddy = oy - sy
                d2 = ddx * ddx + ddy * ddy
                if d2 > 225 then
                    spawn_entity("troid_stage2", ox, oy, sz)
                    adults_spawned = adults_spawned + 1
                endif
            endif
        endif
    next attempt

    add_message(num_to_str(eggs_spawned) + " troid egg clusters detected underground.")
    set_flag("troid_outbreak_started", 1)
endfunction
