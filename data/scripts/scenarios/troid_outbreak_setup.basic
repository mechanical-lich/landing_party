function on_setup()
    add_message("Day 1. Touchdown. Bioscanners are picking up life signs beneath the surface.")

    n = get_region_count("starting_asteroid")
    if n > 0 then
        sx = get_region_x("starting_asteroid", 0)
        sy = get_region_y("starting_asteroid", 0)
        sz = get_region_z("starting_asteroid", 0)
    else
        sx = get_flag("start_x")
        sy = get_flag("start_y")
        sz = get_flag("start_z")
    endif

    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 3, sy - 3, sz, 7, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 3, sz, faction)
    spawn_entity_owned("storage_locker", sx - 2, sy - 2, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 2, sy - 2, sz, sname)

    # With a history origin (the impact the troids came out of) the eggs
    # fester in the caves under it and the first adults are on the surface
    # around it; without one they scatter as before.
    if get_flag("origin_x") >= 0 then
        eggs_spawned = troids_at_origin(sx, sy)
    else
        eggs_spawned = troids_scattered(sx, sy, sz)
    endif

    add_message(num_to_str(eggs_spawned) + " troid egg clusters detected underground.")
    set_flag("troid_outbreak_started", 1)
endfunction

# Eggs within 20 tiles of the impact (caves first, then craters), adults on the surface within
# 15; never inside the landing.
function troids_at_origin(sx, sy)
    ox = get_flag("origin_x")
    oy = get_flag("origin_y")
    oz = get_flag("origin_z")
    add_message("The life signs are thickest under the old impact craters.")
    # Caves first; where the rock under the craters has too few, the rest
    # lie in the craters themselves.
    eggs_spawned = 0
    for attempt = 1 to 400
        if eggs_spawned < 8 then
            ex = -1
            if attempt <= 200 then
                if find_cave_tile_near(ox, oy, 20) = 1 then
                    ex = get_cave_x()
                    ey = get_cave_y()
                    ez = get_cave_z()
                endif
            else
                if find_open_tile_near(ox, oy, oz, 20) = 1 then
                    ex = get_open_x()
                    ey = get_open_y()
                    ez = oz
                endif
            endif
            if ex >= 0 then
                if (ex - sx) * (ex - sx) + (ey - sy) * (ey - sy) > 64 then
                    spawn_entity("troid_egg", ex, ey, ez)
                    eggs_spawned = eggs_spawned + 1
                endif
            endif
        endif
    next attempt
    adults_spawned = 0
    for attempt = 1 to 300
        if adults_spawned < 3 then
            if find_open_tile_near(ox, oy, oz, 15) = 1 then
                ax = get_open_x()
                ay = get_open_y()
                if (ax - sx) * (ax - sx) + (ay - sy) * (ay - sy) > 225 then
                    spawn_entity("troid_stage2", ax, ay, oz)
                    adults_spawned = adults_spawned + 1
                endif
            endif
        endif
    next attempt
    set_flag("troid_origin_eggs", eggs_spawned)
    set_flag("troid_origin_adults", adults_spawned)
    return eggs_spawned
endfunction

# No history: eggs in caves and deep rock floors anywhere, a few adults on the
# surface to signal the outbreak is underway.
function troids_scattered(sx, sy, sz)
    eggs_spawned = 0
    for attempt = 1 to 400
        if eggs_spawned < 8 then
            found = find_cave_tile()
            if found = 1 then
                cx = get_cave_x()
                cy = get_cave_y()
                cz = get_cave_z()
                ddx = cx - sx
                ddy = cy - sy
                d2 = ddx * ddx + ddy * ddy
                if d2 > 64 then
                    spawn_entity("troid_egg", cx, cy, cz)
                    eggs_spawned = eggs_spawned + 1
                endif
            endif
        endif
    next attempt

    # Spawn a few adults already on the surface to signal the outbreak is underway
    adults_spawned = 0
    for attempt = 1 to 300
        if adults_spawned < 3 then
            found = find_open_tile(sz)
            if found = 1 then
                ox = get_open_x()
                oy = get_open_y()
                ddx = ox - sx
                ddy = oy - sy
                d2 = ddx * ddx + ddy * ddy
                if d2 > 225 then
                    spawn_entity("troid_stage2", ox, oy, sz)
                    adults_spawned = adults_spawned + 1
                endif
            endif
        endif
    next attempt

    return eggs_spawned
endfunction
