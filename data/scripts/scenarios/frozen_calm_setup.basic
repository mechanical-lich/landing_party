# The frozen world's calm base: yeti_territory minus the yetis (they come with
# the yeti_return threat and the hostile_fauna hazard).
function on_setup()
    add_message("Day 1. The tundra is quiet. Small things scurry over the ice.")

    sx = get_flag("start_x")
    sy = get_flag("start_y")
    sz = get_flag("start_z")
    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 4, sy - 5, sz, 9, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 1, sz, faction)
    spawn_entity_owned("storage_locker", sx - 3, sy - 3, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 3, sy - 3, sz, sname)

    set_flag("frozen_started", 1)
endfunction
