# The alien world's calm base: alien_world minus the mutants (they come with
# the alien_world threats and the mutant_band hazard).
function on_setup()
    add_message("Day 1. The alien sky is the wrong color, but nothing has come for us yet.")

    sx = get_flag("start_x")
    sy = get_flag("start_y")
    sz = get_flag("start_z")
    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 4, sy - 5, sz, 9, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 1, sz, faction)
    spawn_entity_owned("storage_locker", sx - 3, sy - 3, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 3, sy - 3, sz, sname)

    set_flag("alien_started", 1)
endfunction
