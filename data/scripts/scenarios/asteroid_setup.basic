function on_setup()
    add_message("Day 1. Touchdown on the largest rock. Begin construction.")

    # Land on the tagged starting asteroid if the primer emitted one.
    n = get_region_count("starting_asteroid")
    if n > 0 then
        sx = get_region_x("starting_asteroid", 0)
        sy = get_region_y("starting_asteroid", 0)
        sz = get_region_z("starting_asteroid", 0)
    else
        sx = get_flag("start_x")
        sy = get_flag("start_y")
        sz = get_flag("start_z")
    endif

    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 3, sy - 3, sz, 7, 7, "hull_wall", "hull_floor")
    spawn_entity_owned("airlock", sx, sy + 2, sz, faction)
    spawn_entity_owned("storage_locker", sx - 2, sy - 2, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 2, sy - 2, sz, sname)

    # Pick a creature type for this run (50/50 xeno vs troid)
    use_troid = rnd_int(2)

    # Scatter eggs on asteroids, well away from the landing site
    eggs_spawned = 0
    asteroid_count = get_region_count("asteroid")
    for attempt = 1 to 400
        if eggs_spawned < 5 then
            if asteroid_count > 0 then
                ai = rnd_int(asteroid_count)
                ax = get_region_x("asteroid", ai)
                ay = get_region_y("asteroid", ai)
            else
                ax = sx
                ay = sy
            endif
            ex = ax + rnd_int(17) - 8
            ey = ay + rnd_int(17) - 8
            ddx = ex - sx
            ddy = ey - sy
            d2 = ddx * ddx + ddy * ddy
            ttype = get_tile_type(ex, ey, sz)
            if d2 > 64 and ttype <> "space" and ttype <> "" then
                if use_troid = 1 then
                    spawn_entity("troid_egg", ex, ey, sz)
                    add_message("Troid egg spawned at " + num_to_str(ex) + ", " + num_to_str(ey) + ", " + num_to_str(sz))
                else
                    spawn_entity("xeno_egg", ex, ey, sz)
                    add_message("Xeno egg spawned at " + num_to_str(ex) + ", " + num_to_str(ey) + ", " + num_to_str(sz))
                endif
                eggs_spawned = eggs_spawned + 1
            endif
        endif
    next attempt

    set_flag("asteroid_started", 1)
endfunction
