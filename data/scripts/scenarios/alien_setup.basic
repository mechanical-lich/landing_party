function on_setup()
    add_message("Day 1. The alien sky is the wrong color. Build walls. Quickly.")

    sx = get_flag("start_x")
    sy = get_flag("start_y")
    sz = get_flag("start_z")
    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 4, sy - 5, sz, 9, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 1, sz, faction)
    spawn_entity_owned("storage_locker", sx - 3, sy - 3, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 3, sy - 3, sz, sname)

    # With a history origin (a leaking reactor or wrecked drive) the first
    # mutants stand around it; without one they roam beyond the landing.
    if get_flag("origin_x") >= 0 then
        mutants_at_origin(sx, sy, "mutant_grunt", 3)
    else
        mutants_roaming(sx, sy, sz)
    endif

    set_flag("alien_started", 1)
endfunction

# No history: three grunts more than ~25 tiles from the landing.
function mutants_roaming(sx, sy, sz)
    z = sz
    spawned = 0
    for attempt = 1 to 100
        if spawned < 3 then
            found = find_open_tile(z)
            if found > 0 then
                ox = get_open_x()
                oy = get_open_y()
                dist = (ox - sx) * (ox - sx) + (oy - sy) * (oy - sy)
                if dist > 600 then
                    spawn_entity("mutant_grunt", ox, oy, z)
                    spawned = spawned + 1
                endif
            endif
        endif
    next attempt

endfunction

# n mutants of blueprint within 15 tiles of the origin, outside the landing.
function mutants_at_origin(sx, sy, blueprint, n)
    ox = get_flag("origin_x")
    oy = get_flag("origin_y")
    oz = get_flag("origin_z")
    if get_flag("has_reactor") = 1 then
        add_message("The wildlife near the old reactor has changed. Something is coming from there.")
    else
        add_message("Whatever leaked out there has changed the wildlife. Something is coming from it.")
    endif
    spawned = 0
    for attempt = 1 to 300
        if spawned < n then
            if find_open_tile_near(ox, oy, oz, 15) = 1 then
                mx = get_open_x()
                my = get_open_y()
                if (mx - sx) * (mx - sx) + (my - sy) * (my - sy) > 100 and get_tile_type(mx, my, oz) <> "space" then
                    spawn_entity(blueprint, mx, my, oz)
                    spawned = spawned + 1
                endif
            endif
        endif
    next attempt
    set_flag("mutant_origin_spawned", spawned)
endfunction
