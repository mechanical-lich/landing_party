function on_setup()
    add_message("Day 1. Welcome to your new home. Establish a perimeter.")

    sx = get_flag("start_x")
    sy = get_flag("start_y")
    sz = get_flag("start_z")
    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 4, sy - 5, sz, 9, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 1, sz, faction)
    spawn_entity_owned("storage_locker", sx - 3, sy - 3, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 3, sy - 3, sz, sname)

    # Spawn yetis in caves
    yetis_spawned = 0
    for attempt = 1 to 200
        if yetis_spawned < 3 then
            found = find_cave_tile()
            if found = 1 then
                cx = get_cave_x()
                cy = get_cave_y()
                cz = get_cave_z()
                spawn_entity("yeti", cx, cy, cz)
                yetis_spawned = yetis_spawned + 1
                add_message("Yeti spawned at " + num_to_str(cx) + ", " + num_to_str(cy) + ", " + num_to_str(cz))
            endif
        endif
    next attempt

    set_flag("earth_started", 1)
endfunction
