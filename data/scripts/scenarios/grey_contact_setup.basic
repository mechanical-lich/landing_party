function on_setup()
    add_message("Day 1. The vessel is dark and still. Something is moving inside.")

    n = get_region_count("starting_floor")
    if n > 0 then
        sx = get_region_x("starting_floor", 0)
        sy = get_region_y("starting_floor", 0)
        sz = get_region_z("starting_floor", 0)
    else
        sx = get_flag("start_x")
        sy = get_flag("start_y")
        sz = get_flag("start_z")
    endif

    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    spawn_entity_owned("storage_locker", sx, sy, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 1, sy, sz, sname)

    # With a history origin (the earlier wreck or the station's core the
    # salvage party came for) they are aboard around it; without one they are
    # scattered across every deck as before.
    if get_flag("origin_x") >= 0 then
        greyish_spawned = salvagers_at_origin(sx, sy)
    else
        greyish_spawned = contacts_scattered(sx, sy)
    endif

    add_message(num_to_str(greyish_spawned) + " alien contacts detected aboard the vessel.")
    set_flag("grey_contact_started", 1)
endfunction

# The salvage party: eight contacts within 15 tiles of the origin on its deck,
# never on space tiles or inside the landing.
function salvagers_at_origin(sx, sy)
    ox = get_flag("origin_x")
    oy = get_flag("origin_y")
    oz = get_flag("origin_z")
    civ = get_flag("origin_civ")
    if civ <> "" then
        add_message("A " + civ + " salvage crew is already aboard, working where the old wreckage is.")
    endif
    greyish_spawned = 0
    for attempt = 1 to 400
        if greyish_spawned < 8 then
            if find_open_tile_near(ox, oy, oz, 15) = 1 then
                gx = get_open_x()
                gy = get_open_y()
                if (gx - sx) * (gx - sx) + (gy - sy) * (gy - sy) > 100 and get_tile_type(gx, gy, oz) <> "space" then
                    spawn_contact(gx, gy, oz)
                    greyish_spawned = greyish_spawned + 1
                endif
            endif
        endif
    next attempt
    set_flag("grey_origin_contacts", greyish_spawned)
    return greyish_spawned
endfunction

function spawn_contact(x, y, z)
    pick = rnd_int(4)
    if pick = 0 then
        spawn_entity("greenish", x, y, z)
    else
        if pick = 1 then
            spawn_entity("pinkish", x, y, z)
        else
            if pick = 2 then
                spawn_entity("whitish", x, y, z)
            else
                spawn_entity("greyish", x, y, z)
            endif
        endif
    endif
endfunction

# No history: scatter greyish across all floors of the station.
function contacts_scattered(sx, sy)
    greyish_spawned = 0
    for attempt = 1 to 400
        if greyish_spawned < 8 then
            found = find_open_tile_any_z()
            if found = 1 then
                ox = get_open_x()
                oy = get_open_y()
                oz = get_open_z()
                ddx = ox - sx
                ddy = oy - sy
                d2 = ddx * ddx + ddy * ddy
                if d2 > 100 then
                    pick = rnd_int(4)
                    if pick = 0 then
                        spawn_entity("greenish", ox, oy, oz)
                    else
                        if pick = 1 then
                            spawn_entity("pinkish", ox, oy, oz)
                        else
                            if pick = 2 then
                                spawn_entity("whitish", ox, oy, oz)
                            else
                                spawn_entity("greyish", ox, oy, oz)
                            endif
                        endif
                    endif
                    greyish_spawned = greyish_spawned + 1
                endif
            endif
        endif
    next attempt

    return greyish_spawned
endfunction
