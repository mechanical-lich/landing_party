function on_setup()
    add_message("Day 1. The station hums with residual power. Find the main generator.")

    # Use the starting_floor anchor placed by the abandoned_station primer.
    n = get_region_count("starting_floor")
    if n > 0 then
        sx = get_region_x("starting_floor", 0)
        sy = get_region_y("starting_floor", 0)
        sz = get_region_z("starting_floor", 0)
    else
        sx = get_flag("start_x")
        sy = get_flag("start_y")
        sz = get_flag("start_z")
    endif

    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    spawn_entity_owned("storage_locker", sx, sy, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 1, sy, sz, sname)

    # A station whose history ends in an experiment gone wrong has its first
    # mutants in the dark decks around it; otherwise the station starts quiet.
    if get_flag_or("origin_event", "") = "station_experiment" then
        experiment_mutants(sx, sy)
    endif

    set_flag("station_started", 1)
endfunction

# Three grunts within 15 tiles of the experiment, on its deck, outside the
# landing.
function experiment_mutants(sx, sy)
    ox = get_flag("origin_x")
    oy = get_flag("origin_y")
    oz = get_flag("origin_z")
    add_message("Something moved in the dark decks near the old lab.")
    spawned = 0
    for attempt = 1 to 300
        if spawned < 3 then
            if find_open_tile_near(ox, oy, oz, 15) = 1 then
                mx = get_open_x()
                my = get_open_y()
                if (mx - sx) * (mx - sx) + (my - sy) * (my - sy) > 100 and get_tile_type(mx, my, oz) <> "space" then
                    spawn_entity("mutant_grunt", mx, my, oz)
                    spawned = spawned + 1
                endif
            endif
        endif
    next attempt
    set_flag("mutant_origin_spawned", spawned)
endfunction
