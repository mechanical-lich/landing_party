function on_setup()
    # The hull is the scenario's own stamp, anchored at the history's origin
    # when there is one (data/scenarios/crashed_ufo.json, at: origin); a
    # chapter with no survivors sets chapter_crew = "dead" and the hull comes
    # down empty. Without a history the message is the old one.
    if get_flag("origin_x") >= 0 then
        announce_crash()
    else
        add_message("Day 1. Something came down hard out there. Bioscanners show life signs at the crash site.")
    endif

    n = get_region_count("starting_asteroid")
    if n > 0 then
        sx = get_region_x("starting_asteroid", 0)
        sy = get_region_y("starting_asteroid", 0)
        sz = get_region_z("starting_asteroid", 0)
    else
        sx = get_flag("start_x")
        sy = get_flag("start_y")
        sz = get_flag("start_z")
    endif

    sname = get_flag("settlement_name")
    faction = get_flag("colonist_faction")

    carve_room(sx - 3, sy - 3, sz, 7, 7, "bunker_wall", "bunker_floor")
    spawn_entity_owned("airlock", sx, sy + 3, sz, faction)
    spawn_entity_owned("storage_locker", sx - 2, sy - 2, sz, sname)
    spawn_entity_owned("basic_workbench", sx + 2, sy - 2, sz, sname)

    set_flag("crashed_ufo_started", 1)
endfunction

function announce_crash()
    civ = get_flag("origin_civ")
    if get_flag_or("chapter_crew", "") = "dead" then
        add_message("Day 1. A " + civ + " ship came down hard out there. No life signs at the crash site.")
    else
        add_message("Day 1. A " + civ + " ship came down hard out there. Bioscanners show survivors at the crash site.")
    endif
endfunction
