function on_turn()
    # Faction-aware humanoid AI.
    # find_nearest_enemy automatically skips this entity's own faction and any
    # factions listed in the "ignored_factions" var (comma-separated string).
    # Set it in the blueprint's ScriptedAI vars block, e.g.:
    #   "vars": { "ignored_factions": "wildlife,neutral" }

    # Randomise hostility on first turn (1-10). Persists for this entity's life.
    hostility = get_var("hostility") + 0
    if hostility = 0 then
        hostility = rnd_int(10) + 1
        set_var("hostility", hostility)
    endif

    # Per-turn: log any new sound this entity hears.
    if has_ears() = 1 then
        n = new_sounds()
        if n > 0 then
            add_message("debug: heard " + num_to_str(n) + " sound(s), loudest tag=" + get_sound_tag() + " loud=" + num_to_str(get_sound_loudness()))
            set_var("investigate_x", get_sound_x())
            set_var("investigate_y", get_sound_y())
            set_var("investigate_z", get_sound_z())
            set_var("investigate_ttl", 8)
            set_emote("question", 3, 1)
        endif
    endif

    sx = get_self_x()
    sy = get_self_y()
    sz = get_self_z()

    ranged = has_ranged_weapon()

    # High hostility (7-10): actively hunt enemies
    if hostility >= 7 then
        if find_nearest_enemy(14) = 1 then
            nx = get_nearest_x()
            ny = get_nearest_y()
            nz = get_nearest_z()
            if ranged = 1 then
                if ranged_attack_at(nx, ny, nz) = 1 then
                    return
                endif
            endif
            if dist(sx, sy, nx, ny) <= 1.5 then
                attack_at(nx, ny, nz)
            else
                pathfind_step(nx, ny, nz)
            endif
            return
        endif
    endif

    # Medium hostility (4-6): attack enemies that stray within range 6
    if hostility >= 4 then
        if find_nearest_enemy(6) = 1 then
            nx = get_nearest_x()
            ny = get_nearest_y()
            nz = get_nearest_z()
            if ranged = 1 then
                if ranged_attack_at(nx, ny, nz) = 1 then
                    return
                endif
            endif
            if dist(sx, sy, nx, ny) <= 1.5 then
                attack_at(nx, ny, nz)
            else
                pathfind_step(nx, ny, nz)
            endif
            return
        endif
    endif

    # Continue investigating a previous sound for up to investigate_ttl turns.
    ttl = get_var("investigate_ttl") + 0
    if ttl > 0 then
        ix = get_var("investigate_x") + 0
        iy = get_var("investigate_y") + 0
        iz = get_var("investigate_z") + 0
        if dist(sx, sy, ix, iy) <= 1.5 then
            set_var("investigate_ttl", 0)
        else
            set_var("investigate_ttl", ttl - 1)
            pathfind_step(ix, iy, iz)
            return
        endif
    endif

    # Wander when nothing better to do
    dx = rnd_int(3) - 1
    dy = rnd_int(3) - 1
    move_by(dx, dy)
endfunction
