# Worm AI: burrows underground, surfaces to attack nearby enemies. It feels
# prey through the ground (no line-of-sight), rises no higher than the ground
# above it, and on the surface follows the terrain one level up or down at a
# time; it bites only prey beside it.
# State vars:
#   "surfaced"    — 1 while above ground, 0 while underground
#   "surface_ttl" — turns remaining before retreating underground
#   "dir"         — current burrow direction (1=N 2=E 3=S 4=W)

function on_turn()
    sx = get_self_x()
    sy = get_self_y()
    sz = get_self_z()
    surf_z = get_surface_z(sx, sy)

    # If attacked, surface and retaliate immediately.
    if was_attacked() = 1 then
        ax = get_attacker_x()
        ay = get_attacker_y()
        if sz < surf_z then
            burrow_by(0, 0, 1)
        else
            attack_at(ax, ay, sz)
            set_var("surfaced", 1)
            set_var("surface_ttl", 4)
        endif
        return
    endif

    surfaced = get_var("surfaced") + 0

    # ---- Surfaced behaviour ----
    if surfaced = 1 then
        ttl = get_var("surface_ttl") + 0
        ttl = ttl - 1
        set_var("surface_ttl", ttl)

        # Feel for prey through the ground within 3 tiles. Only prey up on the
        # ground (any height) is chased here; a colonist in a cave below is left
        # for the underground hunt once the worm has dug back down.
        if sense_nearest_enemy(3) = 1 then
            ex = get_nearest_x()
            ey = get_nearest_y()
            ez = get_nearest_z()
            if ez >= get_surface_z(ex, ey) then
                set_var("surface_ttl", 3)
                # Bite if it's beside us, otherwise slither one step toward it.
                if attack_at(ex, ey, ez) = 1 then
                    return
                endif
                ground_step(sx, sy, sz, ex, ey)
                return
            endif
        endif

        # No enemies or timer expired: retreat underground.
        if ttl <= 0 then
            moved = burrow_by(0, 0, -1)
            if moved = 1 then
                sz = sz - 1
            endif
            if sz <= surf_z - 2 then
                set_var("surfaced", 0)
            endif
        endif
        return
    endif

    # ---- Underground behaviour ----
    # Sense prey through the rock (no line-of-sight, any z-level): a colonist on
    # the surface is detectable while the worm is still buried. get_nearest_z
    # tells us whether to rise (surface) or dig deeper toward them.
    sensed = sense_nearest_enemy(10)
    if sensed = 1 then
        # Screech once when first picking up prey (reset when we lose it below).
        if get_var("alerted") + 0 = 0 then
            play_sound("alert")
            set_var("alerted", 1)
        endif
        ex = get_nearest_x()
        ey = get_nearest_y()
        ez = get_nearest_z()

        # Beside it (one level up or down at most): lunge out and bite.
        if attack_at(ex, ey, ez) = 1 then
            set_var("surfaced", 1)
            set_var("surface_ttl", 4)
            return
        endif

        # Both up on the ground: chase across it, climbing and dropping with
        # the terrain rather than tunnelling level through hills.
        if sz >= surf_z and ez >= get_surface_z(ex, ey) then
            if ground_step(sx, sy, sz, ex, ey) = 1 then
                return
            endif
        else
            # Enemy is above — rise toward them, but no higher than our own
            # column's surface (worms can't fly).
            if ez > sz and sz < surf_z then
                burrow_by(0, 0, 1)
                return
            endif

            # Enemy is below — dig down.
            if ez < sz then
                burrow_by(0, 0, -1)
                return
            endif

            # Same level (or as high as we can rise) — tunnel toward them.
            if tunnel_toward(sx, sy, sz, ex, ey) = 1 then
                return
            endif
        endif
    else
        # No prey in range — clear the alert so we screech again next sighting.
        set_var("alerted", 0)
    endif

    # Random burrowing — cardinal directions, change direction when blocked
    # or randomly (~20% chance per turn) to feel organic.
    dir = get_var("dir") + 0
    if dir = 0 then
        dir = rnd_int(4) + 1
        set_var("dir", dir)
    endif

    # Occasional random direction change even when not blocked.
    roll = rnd_int(5)
    if roll = 0 then
        dir = rnd_int(4) + 1
        set_var("dir", dir)
    endif

    dx = 0
    dy = 0
    if dir = 1 then dy = -1 endif
    if dir = 2 then dx = 1 endif
    if dir = 3 then dy = 1 endif
    if dir = 4 then dx = -1 endif

    nx = sx + dx
    ny = sy + dy
    nkind = get_terrain_kind(nx, ny, sz)
    blocked = 0
    if nkind = "void" then blocked = 1 endif
    if nkind = "atmosphere" then blocked = 1 endif

    if blocked = 1 then
        dir = rnd_int(4) + 1
        set_var("dir", dir)
        return
    endif

    moved = burrow_by(dx, dy, 0)
    if moved = 0 then
        dir = rnd_int(4) + 1
        set_var("dir", dir)
    endif
endfunction

# ground_step moves one tile across the surface toward (tx, ty): onto the next
# column's ground, at most one level up or down. Tries the direct step, then
# each axis alone. Returns 1 if the worm moved.
function ground_step(gx, gy, gz, tx, ty)
    gdx = 0
    gdy = 0
    if tx > gx then gdx = 1 endif
    if tx < gx then gdx = -1 endif
    if ty > gy then gdy = 1 endif
    if ty < gy then gdy = -1 endif
    if ground_step_to(gx, gy, gz, gdx, gdy) = 1 then
        return 1
    endif
    if gdx != 0 then
        if gdy != 0 then
            if ground_step_to(gx, gy, gz, gdx, 0) = 1 then
                return 1
            endif
            if ground_step_to(gx, gy, gz, 0, gdy) = 1 then
                return 1
            endif
        endif
    endif
    return 0
endfunction

# ground_step_to makes one ground move by (gdx, gdy); a zero move is no move.
function ground_step_to(gx, gy, gz, gdx, gdy)
    if gdx = 0 and gdy = 0 then
        return 0
    endif
    gnz = get_surface_z(gx + gdx, gy + gdy)
    gdz = gnz - gz
    if gnz < 0 or gdz < -1 or gdz > 1 then
        return 0
    endif
    return burrow_by(gdx, gdy, gdz)
endfunction

# tunnel_toward burrows one tile level toward (tx, ty), longer axis first,
# never out into open air (or off the map). Returns 1 if the worm moved.
function tunnel_toward(gx, gy, gz, tx, ty)
    gdx = 0
    gdy = 0
    if tx > gx then gdx = 1 endif
    if tx < gx then gdx = -1 endif
    if ty > gy then gdy = 1 endif
    if ty < gy then gdy = -1 endif
    gad = tx - gx
    if gad < 0 then gad = -gad endif
    gbd = ty - gy
    if gbd < 0 then gbd = -gbd endif
    if gad >= gbd then
        if tunnel_to(gx, gy, gz, gdx, 0) = 1 then return 1 endif
        if tunnel_to(gx, gy, gz, 0, gdy) = 1 then return 1 endif
    else
        if tunnel_to(gx, gy, gz, 0, gdy) = 1 then return 1 endif
        if tunnel_to(gx, gy, gz, gdx, 0) = 1 then return 1 endif
    endif
    return 0
endfunction

# tunnel_to makes one level move by (gdx, gdy); a zero move is no move.
function tunnel_to(gx, gy, gz, gdx, gdy)
    if gdx = 0 and gdy = 0 then
        return 0
    endif
    gk = get_terrain_kind(gx + gdx, gy + gdy, gz)
    if gk = "atmosphere" or gk = "void" or gk = "space" then
        return 0
    endif
    return burrow_by(gdx, gdy, 0)
endfunction
