# spore_pod — bursts its spores at any colonist standing next to it (a melee
# hit every few turns); never moves. Colonists can cut it down.
function on_turn()
    cool = get_var("cool") + 0
    if cool > 0 then
        set_var("cool", cool - 1)
        return
    endif
    # Radius 1: the colonist's own tile or any of the eight beside it.
    if find_nearest_worker(1) = 1 then
        if attack_at(get_nearest_x(), get_nearest_y(), get_nearest_z()) = 1 then
            set_var("cool", 3)
        endif
    endif
endfunction
