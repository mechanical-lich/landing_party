# bunker — a small walled hull room a quest fixture spawns inside.
# Entrypoint contract: generate(x, y, w, h) where (x,y) is the top-left
# corner of the footprint the dispatcher allocated.
function generate(x, y, w, h)
    cx = x + w / 2
    cy = y + h / 2
    sz = get_surface_z(cx, cy)
    if sz < 0 then
        return
    endif

    carve_room(x, y, sz, w, h, "hull_wall", "hull_floor")

    # Punch a 2-wide breach in a random wall — someone broke in. Pick a
    # side, then a position along it clear of the corners.
    side = rnd_int(4)
    if side = 0 then
        # top wall
        bx = x + 1 + rnd_int(w - 3)
        clear_middle(bx, y, sz)
        clear_middle(bx + 1, y, sz)
    endif
    if side = 1 then
        # bottom wall
        bx = x + 1 + rnd_int(w - 3)
        clear_middle(bx, y + h - 1, sz)
        clear_middle(bx + 1, y + h - 1, sz)
    endif
    if side = 2 then
        # left wall
        by = y + 1 + rnd_int(h - 3)
        clear_middle(x, by, sz)
        clear_middle(x, by + 1, sz)
    endif
    if side = 3 then
        # right wall
        by = y + 1 + rnd_int(h - 3)
        clear_middle(x + w - 1, by, sz)
        clear_middle(x + w - 1, by + 1, sz)
    endif

    # A bit of loot flavor in a corner.
    spawn_entity("storage_locker", x + 1, y + 1, sz)

    # The structure alone decides who lairs here and what they're called.
    # A bunker always has a warden, quest or not.
    # The brute rolls its own mutant name from the blueprint; add a boss
    # epithet before it's marked so the quest title adopts the full name
    # (e.g. "Grosk the Destroyer, mauler of cities").
    spawn_entity("mutant_brute", cx, cy, sz)
    add_epithet(cx, cy, sz)
    # Flag that NPC as the quest target — the quest is told who the target
    # is from here. No-ops harmlessly when there's no associated quest; the
    # warden still exists, it just isn't a bounty.
    mark_quest_target(cx, cy, sz)

    # A couple of guards flanking it (not quest-relevant).
    spawn_entity_named("mutant_grunt", cx - 2, cy, sz, "Bunker Sentry")
    spawn_entity_named("mutant_grunt", cx + 2, cy, sz, "Bunker Sentry")
endfunction
