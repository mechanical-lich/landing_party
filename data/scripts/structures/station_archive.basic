# station_archive — the records vault: shelving lockers along both long
# walls (the archive's holds), a reading console and its datapad. Sealed
# behind a blast door the frame locks (sealed: keycard).
#
# A station module (docs/developer/lore.md, "Stations"): params z, damage
# 0-3, holds (default archive), sealed, event, clue, room_archive.
# occupants: none; a module spawns no one. Sizes 7x7 to 15x11; the centre
# row and column stay clear.
function generate(x, y, w, h)
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    sz = deck_z(x, y, w, h)
    if sz < 0 then
        return
    endif
    carve_room(x, y, sz, w, h, "hull_wall", "hull_floor")
    name_room(x, y, sz, w, h, room("room_archive", "Archive Vault"))
    t = holds_or("archive")
    for i = 1 to w - 2
        if off_aisle(x + i, y + 1, x, y, w, h) = 1 and i - int(i / 2) * 2 = 1 then
            locker(x + i, y + 1, sz, t)
            if h >= 7 then
                locker(x + i, y + h - 2, sz, t)
            endif
        endif
    next i
    spawn_entity("station_console", x + 2, y + h - 2, sz)
    spawn_entity("station_light", x + w - 2, y + 2, sz)
    spawn_lore_datapad(x + 2, y + 2, sz)
    ruin(x, y, w, h)
endfunction

# ── Shared helpers (each station module carries its own copy) ───────────────

# The deck to build on: the param z (a station module), else the ground
# under the footprint (the structure viewer, a cheat stamp without z).
function deck_z(x, y, w, h)
    if has_param("z") = 1 then
        return get_param("z") + 0
    endif
    return get_surface_z(x + int(w / 2), y + int(h / 2))
endfunction

# A room's name: the param key (from the purpose), else def.
function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The param holds, else def: the loot table this module's lockers take.
function holds_or(def)
    v = get_param("holds")
    if v = "" then
        return def
    endif
    return v
endfunction

# A locker at (lx, ly) filled from table ("" leaves it empty).
function locker(lx, ly, lz, table)
    spawn_entity("storage_locker", lx, ly, lz)
    if table <> "" then
        fill_container(lx, ly, lz, table)
    endif
endfunction

# 1 off the cross aisle: a module keeps its centre row and column clear, so
# a door the frame opens in the middle of any wall leads straight in.
function off_aisle(px, py, x, y, w, h)
    if px = x + int(w / 2) or py = y + int(h / 2) then
        return 0
    endif
    return 1
endfunction

# Wear the whole module by the param damage (ruin_pass), as a station wears:
# hull walls fall, floors never crack.
function ruin(x, y, w, h)
    if get_param("damage") + 0 > 0 then
        set_param("wall", "hull_wall")
        set_param("floor", "hull_floor")
        set_param("frame", "station")
        gen_structure("ruin_pass", x, y, w, h)
    endif
endfunction
