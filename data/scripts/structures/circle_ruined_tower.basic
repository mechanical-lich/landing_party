# circle_tower — a stack of circular chambers connected by stairs.
# Rises 4–8 floors from the surface upward. Each floor is a temple-stone
# disc with 1–3 small inner sub-rooms. Stairs alternate columns each level
# so the up tile on floor N lines up with the down tile on floor N+1
# without ever colliding. Ground floor has a breach for outside entry;
# the top floor holds a boss and loot. Guards scatter through the upper
# floors.
#
# Layout per floor (centred on (cx, cy) at z = sz + floor):
#   - Outer disc carved with carve_round_room (radius r)
#   - 1–3 sub-rooms placed at random offsets inside a safe inner zone,
#     each with a single random-side doorway
#   - 5-tile stair strip at row cy, cols col_a..col_b kept clear so the
#     sub-rooms can never wall the stairs off
#
# Recommended footprint: 25×25 or larger.
function generate(x, y, w, h)
    # occupants: "none" builds the structure empty (a history ruin on a quiet
    # site); anything else, or absent, keeps its mutant guards and boss as
    # quest fixtures and scenario stamps always had.
    guards = 1
    if get_param("occupants") = "none" then
        guards = 0
    endif
    cx = x + w / 2
    cy = y + h / 2
    sz = get_surface_z(cx, cy)
    if sz < 0 then
        return
    endif

    height = get_param("height")
    if height = "" then
        height = 4 + rnd_int(5)
    endif

    # Tower radius — largest disc that fits in the footprint with 1-tile
    # outside padding.
    r = w / 2 - 1
    if h / 2 - 1 < r then
        r = h / 2 - 1
    endif
    if r < 5 then
        r = 5
    endif

    # Stair columns sit either side of centre. Alternating per-floor.
    col_a = cx - 2
    col_b = cx + 2

    # ── Each floor ─────────────────────────────────────────────────────────
    for floor = 0 to height - 1
        fz = sz + floor

        # Outer disc.
        carve_round_room(cx, cy, fz, r, "temple_wall", "temple_floor")

        # 1–3 small inner sub-rooms, each with a single doorway.
        n_rooms = 1 + rnd_int(3)
        safe_r = r / 2 - 1
        if safe_r < 1 then
            safe_r = 1
        endif
        # A room keeps at least one tile clear of the rooms already placed on
        # this floor, so no two rooms lay their walls side by side (drawn as a
        # row of posts); a room that finds no clear spot in 12 tries is left
        # out.
        DIM pl_x(3)
        DIM pl_y(3)
        DIM pl_w(3)
        DIM pl_h(3)
        n_pl = 0
        for room_i = 0 to n_rooms - 1
            room_w = 3 + rnd_int(2)
            room_h = 3 + rnd_int(2)
            fits = 0
            rx_room = cx
            ry_room = cy
            for try_i = 1 to 12
                if fits = 0 then
                    off_x = rnd_int(safe_r * 2 + 1) - safe_r
                    off_y = rnd_int(safe_r * 2 + 1) - safe_r
                    rx_room = cx + off_x - room_w / 2
                    ry_room = cy + off_y - room_h / 2
                    fits = 1
                    # ...and clear of the stair strip, which would otherwise
                    # cut through its wall and leave a stub.
                    if ry_room <= cy and cy <= ry_room + room_h and rx_room <= col_b + 1 and col_a - 1 <= rx_room + room_w then
                        fits = 0
                    endif
                    if n_pl > 0 then
                        for pi = 0 to n_pl - 1
                            if rx_room <= pl_x[pi] + pl_w[pi] and pl_x[pi] <= rx_room + room_w and ry_room <= pl_y[pi] + pl_h[pi] and pl_y[pi] <= ry_room + room_h then
                                fits = 0
                            endif
                        next pi
                    endif
                endif
            next try_i
            if fits = 1 then
                pl_x[n_pl] = rx_room
                pl_y[n_pl] = ry_room
                pl_w[n_pl] = room_w
                pl_h[n_pl] = room_h
                n_pl = n_pl + 1
                carve_room(rx_room, ry_room, fz, room_w, room_h, "temple_wall", "temple_floor")
                door_side = rnd_int(4)
                if door_side = 0 then
                    clear_middle(rx_room + room_w / 2, ry_room, fz)
                endif
                if door_side = 1 then
                    clear_middle(rx_room + room_w / 2, ry_room + room_h - 1, fz)
                endif
                if door_side = 2 then
                    clear_middle(rx_room, ry_room + room_h / 2, fz)
                endif
                if door_side = 3 then
                    clear_middle(rx_room + room_w - 1, ry_room + room_h / 2, fz)
                endif
            endif
        next room_i

        # Open a 5-tile strip along the stair row so the sub-rooms can never
        # seal the stairs off from the rest of the floor.
        clear_middle(col_a, cy, fz)
        clear_middle(col_a + 1, cy, fz)
        clear_middle(cx, cy, fz)
        clear_middle(col_b - 1, cy, fz)
        clear_middle(col_b, cy, fz)

        # Stairs alternate columns by floor parity.
        #   parity 0 floors: up at col_a, down at col_b
        #   parity 1 floors: up at col_b, down at col_a
        # → up tile at floor N aligns with down tile at floor N+1.
        half_f = floor / 2
        parity = floor - half_f * 2

        if floor < height - 1 then
            if parity = 0 then
                set_tile(col_a, cy, fz, "stairs_up")
            endif
            if parity = 1 then
                set_tile(col_b, cy, fz, "stairs_up")
            endif
        endif
        if floor > 0 then
            if parity = 0 then
                set_tile(col_b, cy, fz, "stairs_down")
            endif
            if parity = 1 then
                set_tile(col_a, cy, fz, "stairs_down")
            endif
        endif

        # Guards on the upper floors — placed along the perimeter so they
        # generally don't spawn inside a sub-room.
        if floor > 0 then
            if guards = 1 then
                spawn_entity_named("mutant_grunt", cx, cy + r - 2, fz, "Tower Guard")
            endif
            if floor > 1 then
                if guards = 1 then
                    spawn_entity_named("mutant_grunt", cx, cy - r + 2, fz, "Tower Guard")
                endif
            endif
        endif
    next floor

    # ── Ground-floor breach for outside entry ─────────────────────────────
    side = rnd_int(4)
    if side = 0 then
        clear_middle(cx, cy - r, sz)
    endif
    if side = 1 then
        clear_middle(cx, cy + r, sz)
    endif
    if side = 2 then
        clear_middle(cx - r, cy, sz)
    endif
    if side = 3 then
        clear_middle(cx + r, cy, sz)
    endif

    # ── Top floor: boss + loot ────────────────────────────────────────────
    top_z = sz + height - 1
    if guards = 1 then
        spawn_entity("mutant_brute", cx, cy + 3, top_z)
    endif
    if guards = 1 then
        add_epithet(cx, cy + 3, top_z)
    endif
    if guards = 1 then
        mark_quest_target(cx, cy + 3, top_z)
    endif
    spawn_entity("storage_locker", cx, cy - 3, top_z)
endfunction
