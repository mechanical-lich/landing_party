# circle_ruined_tower — a circle_tower worn to a ruin: a wrapper that builds
# circle_tower with damage 2 unless the caller set its own.
#
# Recommended footprint: 25×25.
function generate(x, y, w, h)
    if get_param("damage") = "" then
        set_param("damage", 2)
    endif
    gen_structure("circle_tower", x, y, w, h)
endfunction
