# outpost — a starfaring people's settlement: prefab modules in a row,
# sharing their walls, with doorways between them: a hab module, the
# command module (its datapad and stores), and a store module, a light
# beside each door.
#
# Params: tech (any; built in advanced hull), damage, occupants, holds,
# event, clue, room_hall. Footprint 17x9 to 31x15.
function generate(x, y, w, h)
    # Seeded orientation: the same layout reflected left-right and/or
    # top-bottom (the builtin mirror reflects every coordinate after it).
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    wall = "advanced_wall"
    floor = "advanced_floor"
    cy = y + int(h / 2)
    # Three modules across the footprint; the middle one is command.
    mw = int((w + 2) / 3)
    lw = mw
    rw = w - (lw - 1) - (mw - 1)
    carve_room(x, y, sz, lw, h, wall, floor)
    carve_room(x + lw - 1, y, sz, mw, h, wall, floor)
    carve_room(x + lw + mw - 2, y, sz, rw, h, wall, floor)
    clear_middle(x + lw - 1, cy, sz)
    clear_middle(x + lw + mw - 2, cy, sz)
    # The outer airlock door.
    clear_middle(x, cy, sz)
    name_room(x, y, sz, lw, h, "Hab Module")
    name_room(x + lw - 1, y, sz, mw, h, room("room_hall", "Command Module"))
    name_room(x + lw + mw - 2, y, sz, rw, h, "Store Module")
    for i = 1 to lw - 2
        if i - int(i / 2) * 2 = 1 and h >= 7 then
            spawn_entity("bed", x + i, y + 2, sz)
        endif
    next i
    cmx = x + lw
    spawn_entity("research_lab", cmx, y + 1, sz)
    locker(cmx + 1, y + 1, sz, holds_or("starfaring"))
    spawn_lore_datapad(cmx, y + h - 2, sz)
    spawn_entity("work_light", cmx + mw - 3, y + h - 2, sz)
    sx = x + lw + mw - 1
    spawn_entity("mineral_bin", sx, y + 1, sz)
    fill_container(sx, y + 1, sz, holds_or("starfaring"))
    spawn_entity("fuel_tank", sx, y + h - 2, sz)
    ruin(x, y, w, h, wall, floor)
endfunction

# ── Shared helpers (each ground script carries its own copy) ────────────────

# The wall and floor a people builds with at its tech level (param tech).
function wall_of(tech, def)
    if tech = "primitive" then
        return "overgrown_stone_wall"
    elseif tech = "medieval" then
        return "stone_wall"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_wall"
    elseif tech = "spacefaring" then
        return "advanced_wall"
    endif
    return def
endfunction

function floor_of(tech, def)
    if tech = "primitive" then
        return "dirt_floor"
    elseif tech = "medieval" then
        return "stone_floor"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_floor"
    elseif tech = "spacefaring" then
        return "advanced_floor"
    endif
    return def
endfunction

# A room's name: the param key (from the purpose), else def.
function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The param holds, else def: the loot table this structure's lockers take.
function holds_or(def)
    v = get_param("holds")
    if v = "" then
        return def
    endif
    return v
endfunction

# A locker at (lx, ly) filled from table.
function locker(lx, ly, lz, table)
    spawn_entity("storage_locker", lx, ly, lz)
    fill_container(lx, ly, lz, table)
endfunction

# Wear the whole footprint by the param damage (ruin_pass).
function ruin(x, y, w, h, wall, floor)
    if get_param("damage") + 0 > 0 then
        set_param("wall", wall)
        set_param("floor", floor)
        gen_structure("ruin_pass", x, y, w, h)
    endif
endfunction

# 1 when the param occupants asks for none.
function empty()
    if get_param("occupants") = "none" then
        return 1
    endif
    return 0
endfunction
