# ship_reactor — the drive reactor: a cracked core of radioactive ore, still warm.
# A crashed_ship section: carves its rect (x, y, w, h) in hull, sharing its
# end walls with the sections either side, names the room (param room_reactor, else
# "Reactor") and furnishes it. Furniture keeps off the keel row so the doorways
# crashed_ship opens between sections stay clear.
# A station reuses it as a module: param z is its deck (else the ground under
# it), frame=station marks it a module (no ship-only details), occupants
# defaults to what its caller passes.
function generate(x, y, w, h)
    # A station module comes either way round (a ship's sections face the
    # way crashed_ship lays them).
    if get_param("frame") = "station" then
        mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    endif
    sz = deck_z(x, y, w, h)
    if sz < 0 then
        return
    endif
    carve_room(x, y, sz, w, h, "hull_wall", "hull_floor")
    name_room(x, y, sz, w, h, room("room_reactor", "Reactor"))
    cx = x + int(w / 2)
    # The core sits off the keel row, against the upper wall.
    set_tile(cx, y + 1, sz, "radioactive_ore")
    if w >= 6 then
        set_tile(cx - 1, y + 1, sz, "radioactive_ore")
    endif
    # A ship's core is still warm. A station's is cold until the history
    # broke it: leaking at damage 2, a meltdown's hot core at 3.
    if get_param("frame") <> "station" then
        place_radiation_blob(cx, y + 1, sz, 3, 90)
    elseif get_param("damage") + 0 >= 3 then
        place_radiation_blob(cx, y + 1, sz, 5, 200)
    elseif get_param("damage") + 0 >= 2 then
        place_radiation_blob(cx, y + 1, sz, 3, 90)
    endif
    if h >= 6 then
        spawn_entity("fuel_tank", x + 1, y + h - 2, sz)
        spawn_entity("storage_locker", x + w - 2, y + h - 2, sz)
        fill_container(x + w - 2, y + h - 2, sz, "fission")
    endif
endfunction

function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The deck to build on: the param z (a station module, a docked wreck), else
# the ground under the footprint.
function deck_z(x, y, w, h)
    if has_param("z") = 1 then
        return get_param("z") + 0
    endif
    return get_surface_z(x + int(w / 2), y + int(h / 2))
endfunction
