# nest — a hazard prop: a resin chamber something built and filled with
# eggs. Occupants "none" leaves only cracked husks (what hatched is gone);
# otherwise the eggs (param egg, default xeno_egg; count param eggs,
# default 3) wait to hatch.
#
# Params: egg, eggs, occupants, damage, event, clue. Footprint 9x9 to 15x15.
function generate(x, y, w, h)
    # Seeded orientation: the same layout reflected left-right and/or
    # top-bottom (the builtin mirror reflects every coordinate after it).
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    cx = x + int(w / 2)
    cy = y + int(h / 2)
    r = int(w / 2) - 1
    if int(h / 2) - 1 < r then
        r = int(h / 2) - 1
    endif
    carve_round_room(cx, cy, sz, r, "eldritch_wall", "eldritch_floor")
    # The way in it made for itself.
    clear_middle(cx, cy + r, sz)
    name_room(cx - r, cy - r, sz, r * 2 + 1, r * 2 + 1, room("room_hall", "Nest"))
    egg = get_param("egg")
    if egg = "" then
        egg = "xeno_egg"
    endif
    n = get_param("eggs")
    if n = "" then
        n = 3
    endif
    if empty() = 1 then
        egg = egg + "_cracked"
    endif
    # Eggs on a small ring around the middle.
    for k = 0 to n - 1
        ex = cx - 1 + k - int(k / 3) * 3
        ey = cy - 1 + int(k / 3) * 2
        spawn_entity(egg, ex, ey, sz)
    next k
    spawn_lore_datapad(cx, cy + 2, sz)
endfunction

# ── Shared helpers (each ground script carries its own copy) ────────────────

# The wall and floor a people builds with at its tech level (param tech).
function wall_of(tech, def)
    if tech = "primitive" then
        return "overgrown_stone_wall"
    elseif tech = "medieval" then
        return "stone_wall"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_wall"
    elseif tech = "spacefaring" then
        return "advanced_wall"
    endif
    return def
endfunction

function floor_of(tech, def)
    if tech = "primitive" then
        return "dirt_floor"
    elseif tech = "medieval" then
        return "stone_floor"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_floor"
    elseif tech = "spacefaring" then
        return "advanced_floor"
    endif
    return def
endfunction

# A room's name: the param key (from the purpose), else def.
function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The param holds, else def: the loot table this structure's lockers take.
function holds_or(def)
    v = get_param("holds")
    if v = "" then
        return def
    endif
    return v
endfunction

# A locker at (lx, ly) filled from table.
function locker(lx, ly, lz, table)
    spawn_entity("storage_locker", lx, ly, lz)
    fill_container(lx, ly, lz, table)
endfunction

# Wear the whole footprint by the param damage (ruin_pass).
function ruin(x, y, w, h, wall, floor)
    if get_param("damage") + 0 > 0 then
        set_param("wall", wall)
        set_param("floor", floor)
        gen_structure("ruin_pass", x, y, w, h)
    endif
endfunction

# 1 when the param occupants asks for none.
function empty()
    if get_param("occupants") = "none" then
        return 1
    endif
    return 0
endfunction
