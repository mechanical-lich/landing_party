# gate_vault — the vault holding the gate's controls (pregenerated galaxy,
# plan step 4; campaign/gate.go). underground_dungeon's BSP dungeon, two or
# three levels down a stair shaft, always guarded: a brute ("Vault Warden")
# beside the dormant controls in the far room and three guards on the way,
# every one set to defend the vault (hostility 10).
# Repairing the controls (an ordinary repair order) switches the gate on.
# Placed as a structure fixture on the controls world, so no lore budget can
# drop it. Recommended footprint: 27x23.
function generate(x, y, w, h)
    cx = x + w / 2
    cy = y + h / 2

    depth = get_param("depth")
    if depth = "" then
        depth = 2 + rnd_int(2)
    endif

    # ── Phase 1: BSP planning — compute leaf and room rects, no carving ────
    DIM lx(4)
    DIM ly(4)
    DIM lw(4)
    DIM lh(4)
    DIM rx(4)
    DIM ry(4)
    DIM rw(4)
    DIM rh(4)

    lx[0] = x + 1
    ly[0] = y + 1
    lw[0] = w - 2
    lh[0] = h - 2

    n = 1
    for s = 1 to 2
        base = n
        for i = 0 to base - 1
            wi = lw[i]
            hi = lh[i]
            xi = lx[i]
            yi = ly[i]

            vert = 0
            if wi >= hi then
                vert = 1
            endif

            if vert = 1 then
                sat = wi * 4 / 10 + rnd_int(wi * 2 / 10 + 1)
                if sat < 4 then
                    sat = 4
                endif
                if sat > wi - 4 then
                    sat = wi - 4
                endif
                lx[n] = xi + sat
                ly[n] = yi
                lw[n] = wi - sat
                lh[n] = hi
                lw[i] = sat
            endif
            if vert = 0 then
                sat = hi * 4 / 10 + rnd_int(hi * 2 / 10 + 1)
                if sat < 4 then
                    sat = 4
                endif
                if sat > hi - 4 then
                    sat = hi - 4
                endif
                lx[n] = xi
                ly[n] = yi + sat
                lw[n] = wi
                lh[n] = hi - sat
                lh[i] = sat
            endif
            n = n + 1
        next i
    next s

    for i = 0 to 3
        room_w = lw[i] - 4 - rnd_int(3)
        room_h = lh[i] - 4 - rnd_int(3)
        if room_w < 5 then
            room_w = 5
        endif
        if room_h < 5 then
            room_h = 5
        endif
        if room_w > lw[i] - 2 then
            room_w = lw[i] - 2
        endif
        if room_h > lh[i] - 2 then
            room_h = lh[i] - 2
        endif
        slack_x = lw[i] - 2 - room_w
        slack_y = lh[i] - 2 - room_h
        off_x = 0
        off_y = 0
        if slack_x > 0 then
            off_x = rnd_int(slack_x + 1)
        endif
        if slack_y > 0 then
            off_y = rnd_int(slack_y + 1)
        endif
        rx[i] = lx[i] + 1 + off_x
        ry[i] = ly[i] + 1 + off_y
        rw[i] = room_w
        rh[i] = room_h
    next i

    # ── Phase 2: pick stair tile inside room 0 ─────────────────────────────
    # Drop the stair tile inside room 0. Guarantee stair_x and stair_x+1 are
    # both interior so the alternating-column shaft fits.
    stair_x = rx[0] + rw[0] / 2
    stair_y = ry[0] + rh[0] / 2
    if stair_x + 1 > rx[0] + rw[0] - 2 then
        stair_x = rx[0] + rw[0] - 3
    endif
    col_a = stair_x
    col_b = stair_x + 1

    # Anchor the Z axis to the actual surface at the stair tile. The dungeon,
    # shaft, and surface room are all derived from THIS sz so they line up
    # with the terrain right where the player will see the entrance.
    sz = get_surface_z(stair_x, stair_y)
    if sz < 0 then
        sz = get_surface_z(cx, cy)
    endif
    if sz < 0 then
        return
    endif
    dz = sz - depth

    # ── Phase 3: carve dungeon rooms at dz ─────────────────────────────────
    for i = 0 to 3
        carve_room(rx[i], ry[i], dz, rw[i], rh[i], "dungeon_wall", "dungeon_floor")
    next i

    # ── Phase 4: corridors between BSP sibling pairs ───────────────────────
    DIM pa(3)
    DIM pb(3)
    pa[0] = 0
    pb[0] = 1
    pa[1] = 0
    pb[1] = 2
    pa[2] = 1
    pb[2] = 3

    for p = 0 to 2
        a = pa[p]
        b = pb[p]

        al = rx[a]
        ar = rx[a] + rw[a] - 1
        at = ry[a]
        ab = ry[a] + rh[a] - 1
        bl = rx[b]
        br = rx[b] + rw[b] - 1
        bt = ry[b]
        bb = ry[b] + rh[b] - 1

        sep_x = 0
        if ar < bl then
            sep_x = 1
        endif
        if al > br then
            sep_x = 1
        endif
        sep_y = 0
        if ab < bt then
            sep_y = 1
        endif
        if at > bb then
            sep_y = 1
        endif

        if sep_x = 1 then
            if sep_y = 0 then
                yo_top = at + 1
                if bt + 1 > yo_top then
                    yo_top = bt + 1
                endif
                yo_bot = ab - 1
                if bb - 1 < yo_bot then
                    yo_bot = bb - 1
                endif
                if yo_top <= yo_bot then
                    Y = (yo_top + yo_bot) / 2
                    h_start = 0
                    h_end = -1
                    a_exit = 0
                    b_entry = 0
                    if ar < bl then
                        h_start = ar + 1
                        h_end = bl - 1
                        a_exit = ar
                        b_entry = bl
                    endif
                    if al > br then
                        h_start = br + 1
                        h_end = al - 1
                        a_exit = al
                        b_entry = br
                    endif
                    if h_start <= h_end then
                        carve_room(h_start, Y - 1, dz, h_end - h_start + 1, 3, "dungeon_wall", "dungeon_floor")
                        clear_middle(h_start, Y, dz)
                        clear_middle(h_end, Y, dz)
                    endif
                    clear_middle(a_exit, Y, dz)
                    clear_middle(b_entry, Y, dz)
                endif
            endif
        endif

        if sep_y = 1 then
            if sep_x = 0 then
                xo_lt = al + 1
                if bl + 1 > xo_lt then
                    xo_lt = bl + 1
                endif
                xo_rt = ar - 1
                if br - 1 < xo_rt then
                    xo_rt = br - 1
                endif
                if xo_lt <= xo_rt then
                    X = (xo_lt + xo_rt) / 2
                    v_start = 0
                    v_end = -1
                    a_exit = 0
                    b_entry = 0
                    if ab < bt then
                        v_start = ab + 1
                        v_end = bt - 1
                        a_exit = ab
                        b_entry = bt
                    endif
                    if at > bb then
                        v_start = bb + 1
                        v_end = at - 1
                        a_exit = at
                        b_entry = bb
                    endif
                    if v_start <= v_end then
                        carve_room(X - 1, v_start, dz, 3, v_end - v_start + 1, "dungeon_wall", "dungeon_floor")
                        clear_middle(X, v_start, dz)
                        clear_middle(X, v_end, dz)
                    endif
                    clear_middle(X, a_exit, dz)
                    clear_middle(X, b_entry, dz)
                endif
            endif
        endif

        if sep_x = 1 then
            if sep_y = 1 then
                Y = (at + ab) / 2
                X = (bl + br) / 2

                h_start = 0
                h_end = -1
                a_exit_col = 0
                if X > ar then
                    h_start = ar + 1
                    h_end = X
                    a_exit_col = ar
                endif
                if X < al then
                    h_start = X
                    h_end = al - 1
                    a_exit_col = al
                endif
                if h_start <= h_end then
                    carve_room(h_start, Y - 1, dz, h_end - h_start + 1, 3, "dungeon_wall", "dungeon_floor")
                    clear_middle(h_start, Y, dz)
                    clear_middle(h_end, Y, dz)
                endif
                clear_middle(a_exit_col, Y, dz)

                v_start = 0
                v_end = -1
                b_entry_row = 0
                if Y < bt then
                    v_start = Y
                    v_end = bt - 1
                    b_entry_row = bt
                endif
                if Y > bb then
                    v_start = bb + 1
                    v_end = Y
                    b_entry_row = bb
                endif
                if v_start <= v_end then
                    carve_room(X - 1, v_start, dz, 3, v_end - v_start + 1, "dungeon_wall", "dungeon_floor")
                    clear_middle(X, v_start, dz)
                    clear_middle(X, v_end, dz)
                endif
                clear_middle(X, b_entry_row, dz)
                clear_middle(X, Y, dz)
            endif
        endif
    next p

    # ── Phase 5: stairs_up at the bottom ───────────────────────────────────
    set_tile(col_a, stair_y, dz, "stairs_up")

    # ── Phase 6: intermediate shaft levels ─────────────────────────────────
    # From the bottom up, every stairs_down stands over the stairs_up of the
    # level below (the path check wants a down and an up for every level
    # changed), the columns alternating. (underground_dungeon's parity sum
    # divides with "/", which is not whole here, so its shaft never pairs.)
    downc = col_a
    for k = 1 to depth - 1
        lz = dz + k
        upc = col_b
        if downc = col_b then
            upc = col_a
        endif
        carve_room(col_a - 1, stair_y - 1, lz, 4, 3, "dungeon_wall", "dungeon_floor")
        set_tile(downc, stair_y, lz, "stairs_down")
        set_tile(upc, stair_y, lz, "stairs_up")
        downc = upc
    next k

    # The surface stairs_down stands over the topmost stairs_up.
    surface_col = downc

    # ── Phase 7: surface entrance — fixed-size room around the stair tile.
    # 9×9 with the stair tile at its exact centre (cell 4,4 of the room).
    # Odd dimensions make the centre unambiguous, no clamping needed.
    sr_tx = surface_col - 4
    sr_ty = stair_y - 4
    carve_room(sr_tx, sr_ty, sz, 9, 9, "dungeon_wall", "dungeon_floor")

    # A door in every outer wall: the vault always opens onto ground the
    # landing can reach, whichever way that lies.
    clear_middle(surface_col, sr_ty, sz)
    clear_middle(surface_col, sr_ty + 8, sz)
    clear_middle(sr_tx, stair_y, sz)
    clear_middle(sr_tx + 8, stair_y, sz)

    set_tile(surface_col, stair_y, sz, "stairs_down")

    # ── Phase 8: the controls at the far end, and their guards ────────────
    # Room 0 holds the stair down from the surface; room 3, the last of the
    # BSP, the gate's controls in its far corner, a brute beside them and
    # guards in the rooms between.
    ctl_x = rx[3] + rw[3] - 2
    ctl_y = ry[3] + 1

    # A passage from the stair to beside the controls, through rock and
    # rooms alike: the BSP's corridors join siblings, and sometimes leave the
    # far room cut off, which here would make the galaxy unwinnable.
    tx = ctl_x - 1
    ty = ctl_y + 1
    if tx = col_a then
        tx = col_a + 1
    endif
    lo = col_a + 1
    hi = tx
    if tx < col_a then
        lo = tx
        hi = col_a - 1
    endif
    for xx = lo to hi
        set_tile(xx, stair_y, dz, "dungeon_floor")
        clear_middle(xx, stair_y, dz)
    next xx
    lo = stair_y
    hi = ty
    if ty < stair_y then
        lo = ty
        hi = stair_y
    endif
    for yy = lo to hi
        set_tile(tx, yy, dz, "dungeon_floor")
        clear_middle(tx, yy, dz)
    next yy
    spawn_entity("gate_controls_dormant", ctl_x, ctl_y, dz)

    boss_cx = rx[3] + rw[3] / 2
    boss_cy = ry[3] + rh[3] / 2
    spawn_entity_named("mutant_brute", boss_cx, boss_cy, dz, "Vault Warden")
    set_ai_var(boss_cx, boss_cy, dz, "hostility", 10)
    gx = rx[1] + rw[1] / 2
    gy = ry[1] + rh[1] / 2
    spawn_entity_named("mutant_grunt", gx, gy, dz, "Vault Guard")
    set_ai_var(gx, gy, dz, "hostility", 10)
    gx = rx[2] + rw[2] - 2
    gy = ry[2] + rh[2] / 2
    spawn_entity_named("mutant_grunt", gx, gy, dz, "Vault Guard")
    set_ai_var(gx, gy, dz, "hostility", 10)
    gx = rx[3] + 1
    gy = ry[3] + rh[3] - 2
    spawn_entity_named("mutant_grunt", gx, gy, dz, "Vault Guard")
    set_ai_var(gx, gy, dz, "hostility", 10)
    spawn_entity("storage_locker", rx[2] + 1, ry[2] + 1, dz)
endfunction
