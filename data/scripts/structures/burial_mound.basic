# burial_mound — a primitive people's grave: a sealed chamber under a low
# mound, ringed by paired stones; its grave goods (by tech) lie in a locker
# beside the dead, and a narrow passage leads in.
#
# Params: tech, damage, occupants, holds, event, clue, room_hall.
# Footprint 11x11 to 19x19.
function generate(x, y, w, h)
    # Seeded orientation: the same layout reflected left-right and/or
    # top-bottom (the builtin mirror reflects every coordinate after it).
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    tech = get_param("tech")
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    wall = "overgrown_stone_wall"
    floor = "dirt_floor"
    cx = x + int(w / 2)
    cy = y + int(h / 2)
    # The chamber.
    carve_room(cx - 2, cy - 2, sz, 5, 5, wall, floor)
    clear_middle(cx, cy + 2, sz)
    name_room(cx - 2, cy - 2, sz, 5, 5, room("room_hall", "Burial Chamber"))
    goods = "trade_goods"
    if tech = "medieval" then
        goods = "old_weapons"
    endif
    locker(cx - 1, cy - 1, sz, holds_or(goods))
    spawn_lore_datapad(cx + 1, cy - 1, sz)
    # The ring of paired stones around the mound.
    r = int(w / 2) - 1
    if int(h / 2) - 1 < r then
        r = int(h / 2) - 1
    endif
    if r >= 5 then
        pair(cx - 1, cy - r, sz, 1, 0)
        pair(cx - r, cy - 1, sz, 0, 1)
        pair(cx + r, cy - 1, sz, 0, 1)
        pair(cx + 2, cy + r, sz, 1, 0)
    endif
    if get_param("damage") + 0 >= 2 then
        # Grave robbers dug in from the north.
        clear_middle(cx, cy - 2, sz)
    endif
endfunction

function pair(px, py, sz, ddx, ddy)
    set_tile(px, py, sz, "overgrown_stone_wall")
    set_tile(px + ddx, py + ddy, sz, "overgrown_stone_wall")
endfunction

# ── Shared helpers (each ground script carries its own copy) ────────────────

# The wall and floor a people builds with at its tech level (param tech).
function wall_of(tech, def)
    if tech = "primitive" then
        return "overgrown_stone_wall"
    elseif tech = "medieval" then
        return "stone_wall"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_wall"
    elseif tech = "spacefaring" then
        return "advanced_wall"
    endif
    return def
endfunction

function floor_of(tech, def)
    if tech = "primitive" then
        return "dirt_floor"
    elseif tech = "medieval" then
        return "stone_floor"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_floor"
    elseif tech = "spacefaring" then
        return "advanced_floor"
    endif
    return def
endfunction

# A room's name: the param key (from the purpose), else def.
function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The param holds, else def: the loot table this structure's lockers take.
function holds_or(def)
    v = get_param("holds")
    if v = "" then
        return def
    endif
    return v
endfunction

# A locker at (lx, ly) filled from table.
function locker(lx, ly, lz, table)
    spawn_entity("storage_locker", lx, ly, lz)
    fill_container(lx, ly, lz, table)
endfunction

# Wear the whole footprint by the param damage (ruin_pass).
function ruin(x, y, w, h, wall, floor)
    if get_param("damage") + 0 > 0 then
        set_param("wall", wall)
        set_param("floor", floor)
        gen_structure("ruin_pass", x, y, w, h)
    endif
endfunction

# 1 when the param occupants asks for none.
function empty()
    if get_param("occupants") = "none" then
        return 1
    endif
    return 0
endfunction
