# city_block — an industrial or atomic people's dwellings: buildings in a
# grid with 2-wide streets between them, each a hall split into two rooms,
# its door on the street. One building is the block's office, holding its
# records (the datapad) and goods.
#
# Params: tech (industrial | atomic; others build as industrial), damage,
# occupants, holds, event, clue, room_hall. Footprint 21x17 to 37x29.
function generate(x, y, w, h)
    # Seeded orientation: the same layout reflected left-right and/or
    # top-bottom (the builtin mirror reflects every coordinate after it).
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    tech = get_param("tech")
    if tech = "" then
        tech = "industrial"
    endif
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    wall = wall_of(tech, "bunker_wall")
    floor = floor_of(tech, "bunker_floor")
    # Buildings 8x6 on a 10x8 grid (2-tile streets), centred.
    cols = int((w - 1) / 10)
    rows = int((h - 1) / 8)
    ox = x + 1 + int((w - 1 - cols * 10) / 2)
    oy = y + 1 + int((h - 1 - rows * 8) / 2)
    office = rnd_int(cols * rows)
    k = 0
    for r = 0 to rows - 1
        for c = 0 to cols - 1
            bx = ox + c * 10
            by = oy + r * 8
            carve_room(bx, by, sz, 8, 6, wall, floor)
            # A partition with a doorway splits it in two.
            for j = 1 to 4
                set_tile(bx + 4, by + j, sz, floor)
            next j
            carve_room(bx + 4, by, sz, 4, 6, wall, floor)
            clear_middle(bx + 4, by + 2, sz)
            # The street door.
            clear_middle(bx + 2, by + 5, sz)
            name_room(bx, by, sz, 8, 6, "Tenement")
            if k = office then
                name_room(bx, by, sz, 8, 6, room("room_hall", "Block Office"))
                locker(bx + 6, by + 1, sz, holds_or("machine_parts"))
                spawn_lore_datapad(bx + 1, by + 1, sz)
            else
                spawn_entity("bed", bx + 1, by + 2, sz)
            endif
            k = k + 1
        next c
    next r
    ruin(x, y, w, h, wall, floor)
endfunction

# ── Shared helpers (each ground script carries its own copy) ────────────────

# The wall and floor a people builds with at its tech level (param tech).
function wall_of(tech, def)
    if tech = "primitive" then
        return "overgrown_stone_wall"
    elseif tech = "medieval" then
        return "stone_wall"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_wall"
    elseif tech = "spacefaring" then
        return "advanced_wall"
    endif
    return def
endfunction

function floor_of(tech, def)
    if tech = "primitive" then
        return "dirt_floor"
    elseif tech = "medieval" then
        return "stone_floor"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_floor"
    elseif tech = "spacefaring" then
        return "advanced_floor"
    endif
    return def
endfunction

# A room's name: the param key (from the purpose), else def.
function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The param holds, else def: the loot table this structure's lockers take.
function holds_or(def)
    v = get_param("holds")
    if v = "" then
        return def
    endif
    return v
endfunction

# A locker at (lx, ly) filled from table.
function locker(lx, ly, lz, table)
    spawn_entity("storage_locker", lx, ly, lz)
    fill_container(lx, ly, lz, table)
endfunction

# Wear the whole footprint by the param damage (ruin_pass).
function ruin(x, y, w, h, wall, floor)
    if get_param("damage") + 0 > 0 then
        set_param("wall", wall)
        set_param("floor", floor)
        gen_structure("ruin_pass", x, y, w, h)
    endif
endfunction

# 1 when the param occupants asks for none.
function empty()
    if get_param("occupants") = "none" then
        return 1
    endif
    return 0
endfunction
