# graveyard — a people's dead in rows inside a low wall, a chapel (its
# datapad and the names of the dead) in the north-west corner. An atomic
# people's graveyard is mass graves: long trenches of disturbed ground.
#
# Params: tech, damage, occupants, holds, event, clue, room_hall.
# Footprint 15x11 to 29x21.
function generate(x, y, w, h)
    # Seeded orientation: the same layout reflected left-right and/or
    # top-bottom (the builtin mirror reflects every coordinate after it).
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    tech = get_param("tech")
    if tech = "" then
        tech = "medieval"
    endif
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    wall = wall_of(tech, "stone_wall")
    floor = floor_of(tech, "stone_floor")
    cx = x + int(w / 2)
    # The wall, with a gate on the south side.
    carve_room(x, y, sz, w, h, wall, "dirt_floor")
    clear_middle(cx, y + h - 1, sz)
    clear_middle(cx - 1, y + h - 1, sz)
    # The chapel, two tiles inside the wall.
    carve_room(x + 2, y + 2, sz, 5, 4, wall, floor)
    clear_middle(x + 4, y + 5, sz)
    name_room(x + 2, y + 2, sz, 5, 4, room("room_hall", "Chapel"))
    locker(x + 3, y + 3, sz, holds_or("archive"))
    spawn_lore_datapad(x + 5, y + 3, sz)
    name_room(x, y, sz, w, h, "Graveyard")
    name_room(x + 2, y + 2, sz, 5, 4, room("room_hall", "Chapel"))
    # The graves: from the chapel's east to the far wall.
    if tech = "atomic" then
        for gy = y + 3 to y + h - 3
            if gy - int(gy / 3) * 3 = 0 then
                for gx = x + 9 to x + w - 3
                    set_tile(gx, gy, sz, "crater_ground")
                next gx
            endif
        next gy
    else
        for gy = y + 2 to y + h - 3
            if (gy - y) - int((gy - y) / 2) * 2 = 0 then
                for gx = x + 9 to x + w - 3
                    # A plot in four was never filled, or has sunk away.
                    if (gx - x) - int((gx - x) / 2) * 2 = 1 and rnd_int(4) > 0 then
                        set_tile(gx, gy, sz, "rubble_pile")
                    endif
                next gx
            endif
        next gy
    endif
    ruin(x, y, w, h, wall, floor)
endfunction

# ── Shared helpers (each ground script carries its own copy) ────────────────

# The wall and floor a people builds with at its tech level (param tech).
function wall_of(tech, def)
    if tech = "primitive" then
        return "overgrown_stone_wall"
    elseif tech = "medieval" then
        return "stone_wall"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_wall"
    elseif tech = "spacefaring" then
        return "advanced_wall"
    endif
    return def
endfunction

function floor_of(tech, def)
    if tech = "primitive" then
        return "dirt_floor"
    elseif tech = "medieval" then
        return "stone_floor"
    elseif tech = "industrial" or tech = "atomic" then
        return "bunker_floor"
    elseif tech = "spacefaring" then
        return "advanced_floor"
    endif
    return def
endfunction

# A room's name: the param key (from the purpose), else def.
function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction

# The param holds, else def: the loot table this structure's lockers take.
function holds_or(def)
    v = get_param("holds")
    if v = "" then
        return def
    endif
    return v
endfunction

# A locker at (lx, ly) filled from table.
function locker(lx, ly, lz, table)
    spawn_entity("storage_locker", lx, ly, lz)
    fill_container(lx, ly, lz, table)
endfunction

# Wear the whole footprint by the param damage (ruin_pass).
function ruin(x, y, w, h, wall, floor)
    if get_param("damage") + 0 > 0 then
        set_param("wall", wall)
        set_param("floor", floor)
        gen_structure("ruin_pass", x, y, w, h)
    endif
endfunction

# 1 when the param occupants asks for none.
function empty()
    if get_param("occupants") = "none" then
        return 1
    endif
    return 0
endfunction
