# hive_core — a campaign hive presence's hive stage (docs/developer/factions.md,
# Tier 2): a wide resin chamber with two ways in and a hollow at its heart
# where the presence's egg launcher stands. Terrain only; the world manager
# spawns the launcher, eggs and creatures. Footprint 17x17 to 25x25.
function generate(x, y, w, h)
    mirror(x, y, w, h, rnd_int(2), rnd_int(2))
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    cx = x + int(w / 2)
    cy = y + int(h / 2)
    r = int(w / 2) - 1
    if int(h / 2) - 1 < r then
        r = int(h / 2) - 1
    endif
    carve_round_room(cx, cy, sz, r, "eldritch_wall", "hive_resin")
    clear_middle(cx, cy + r, sz)
    clear_middle(cx - r, cy, sz)
    # DRAFT room names (hidden identity: never "Hive").
    name_room(cx - r, cy - r, sz, r * 2 + 1, r * 2 + 1, "Great Nest")
    name_room(cx - 2, cy - 2, sz, 5, 5, "Nest Heart")
endfunction
