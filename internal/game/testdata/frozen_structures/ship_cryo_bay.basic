# ship_cryo_bay — rows of cryo berths and the ship's medical stores; with occupants "cryo" someone is still asleep in them.
# A crashed_ship section: carves its rect (x, y, w, h) in hull, sharing its
# end walls with the sections either side, names the room (param room_cryo, else
# "Cryo Bay") and furnishes it. Furniture keeps off the keel row so the doorways
# crashed_ship opens between sections stay clear.
function generate(x, y, w, h)
    sz = get_surface_z(x + int(w / 2), y + int(h / 2))
    if sz < 0 then
        return
    endif
    carve_room(x, y, sz, w, h, "hull_wall", "hull_floor")
    name_room(x, y, sz, w, h, room("room_cryo", "Cryo Bay"))
    sleepers = 0
    if get_param("occupants") = "cryo" then
        sleepers = 1
    endif
    # The locker (rooms 7+ tall) takes the last column: bunks stop short of it,
    # since a bed covers its anchor and the tile above.
    last = w - 2
    if h >= 7 then
        last = w - 3
    endif
    for i = 1 to last
        if i - int(i / 2) * 2 = 1 then
            # A bed is two tiles tall, anchored at its lower one.
            spawn_entity("bed", x + i, y + 2, sz)
            if h >= 7 then
                spawn_entity("bed", x + i, y + h - 2, sz)
            endif
            # A berth that never opened: its sleeper stands up when woken.
            if sleepers = 1 and h >= 6 and rnd_int(2) = 0 then
                spawn_entity_named("greyish", x + i, y + 3, sz, "Cryo Sleeper")
            endif
        endif
    next i
    if h >= 7 then
        spawn_entity("storage_locker", x + w - 2, y + 1, sz)
        fill_container(x + w - 2, y + 1, sz, "medical")
    endif
endfunction

function room(key, def)
    v = get_param(key)
    if v = "" then
        return def
    endif
    return v
endfunction
