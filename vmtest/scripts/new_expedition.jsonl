{"name":"new_expedition","seed":777,"config":{"rivalsByCount":true}}
# Title -> New Expedition with seed 777, the tutorial off and the Rival factions
# stepper walked to both ends and back to its default -> Star Map (adrift)
# -> travel to the landfall system (sys_55, Gleaming Cradle) -> beam two colonists down -> To Site -> 600 ticks.
# The landfall system is a first jump, so its history ends safe (here a
# earth_like world) and the crew is still standing after 600 ticks.
{"op":"wait","ticks":10}
{"op":"assert","path":"state","eq":"title"}
{"op":"screenshot","name":"title"}
{"op":"click","target":"title:new"}
{"op":"assert","path":"title_screen","eq":"new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"VM Test"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"777"}
{"op":"click","target":"title:tutorial"}
{"op":"assert","path":"title_fields.tutorial","eq":false}
{"op":"assert","path":"title_fields.seed","eq":"777"}
# Rival factions: default 1 (generation.json), clamped to 0..factions_max (4).
{"op":"assert","path":"title_fields.factions","eq":1}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"assert","path":"title_fields.factions","eq":4}
{"op":"screenshot","name":"factions_max"}
{"op":"click","target":"title:factions_minus"}
{"op":"click","target":"title:factions_minus"}
{"op":"click","target":"title:factions_minus"}
{"op":"click","target":"title:factions_minus"}
{"op":"click","target":"title:factions_minus"}
{"op":"assert","path":"title_fields.factions","eq":0}
{"op":"click","target":"title:factions_plus"}
{"op":"assert","path":"title_fields.factions","eq":1}
{"op":"screenshot","name":"new_screen"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"assert","path":"dash_tab","eq":"starmap"}
{"op":"assert","path":"campaign.adrift","eq":true}
{"op":"assert","path":"campaign.in_orbit","eq":false}
{"op":"assert","path":"campaign.seed","eq":777}
{"op":"assert","path":"campaign.faction_count","eq":1}
# The seeded presence is never on the start system (the safe first jump).
{"op":"assert","path":"campaign.presences.sys_55","eq":null}
{"op":"assert","path":"tutorial","eq":null}
{"op":"assert","path":"fuel","eq":200}
{"op":"assert","path":"crew_at.ship","eq":6}
{"op":"save_as","name":"adrift"}
{"op":"screenshot","name":"adrift"}
{"op":"click","target":"row:locList:start"}
{"op":"assert","path":"selected_location.id","eq":"sys_55"}
{"op":"assert","path":"selected_location.fuel_cost","eq":8}
{"op":"screenshot","name":"picked"}
{"op":"click","target":"dash:travelBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.adrift","eq":false}
{"op":"assert","path":"campaign.in_orbit","eq":true}
{"op":"assert","path":"campaign.location_id","eq":"sys_55"}
# Fuel fell by the cost the Star Map showed (200 - 8).
{"op":"assert","path":"fuel","eq":192}
{"op":"assert","path":"hold.fuel","eq":192}
{"op":"screenshot","name":"traveled"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"crew_at.ship","eq":4}
{"op":"assert","path":"crew_on_site","eq":2}
{"op":"screenshot","name":"beamed"}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"screenshot","name":"site"}
{"op":"wait","ticks":600}
{"op":"assert","path":"state","eq":"site"}
{"op":"assert","path":"crew_on_site","eq":2}
{"op":"assert","path":"paused","eq":false}
{"op":"assert","path":"tick","gte":600}
{"op":"screenshot","name":"site600"}
