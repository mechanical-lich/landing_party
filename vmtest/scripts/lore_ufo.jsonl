{"name":"lore_ufo","seed":1372}
# A warship shot down at the history's origin, its crew at the hull.
# New expedition (seed 1372, tutorial off) -> jump straight to sys_46, whose
# history ends in ship_shot_down -> beam one colonist down -> land -> frame the camera on
# the history's origin and look at what stands there.
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Lore lore_ufo"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"1372"}
{"op":"click","target":"title:tutorial"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"click","target":"row:locList:sys_46"}
{"op":"assert","path":"selected_location.id","eq":"sys_46"}
{"op":"assert","path":"selected_location.history_summary","eq":true}
{"op":"click","target":"dash:travelBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.location_id","eq":"sys_46"}
{"op":"assert","path":"campaign.chapter","eq":"ship_shot_down"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"debug","cmd":"origin walk"}
{"op":"wait","ticks":20}
{"op":"move","target":"region:lore_origin"}
{"op":"screenshot","name":"origin"}
