{"name":"lore_site","seed":777,"config":{"rivalsByCount":true}}
# New expedition (seed 777, tutorial off) -> the start system's Star Map summary
# is its history's line -> travel -> beam one down -> land and look at the site.
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Lore Test"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"777"}
{"op":"click","target":"title:tutorial"}
{"op":"assert","path":"title_fields.tutorial","eq":false}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"assert","path":"campaign.known_events","eq":0}
{"op":"click","target":"row:locList:start"}
{"op":"assert","path":"selected_location.id","eq":"start"}
# The summary line is the start system's history, not the archetype sentence.
{"op":"assert","path":"selected_location.history_summary","eq":true}
{"op":"assert","path":"selected_location.tier","eq":"quiet"}
{"op":"screenshot","name":"starmap_summary"}
{"op":"click","target":"dash:travelBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.location_id","eq":"start"}
{"op":"assert","path":"campaign.in_orbit","eq":true}
{"op":"save_as","name":"orbit"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"crew_on_site","eq":1}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"screenshot","name":"site"}
{"op":"assert","path":"campaign.chapter","eq_saved":"orbit"}
