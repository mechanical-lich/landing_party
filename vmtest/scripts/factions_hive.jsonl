{"op":"debug","cmd":"faction"}
{"op":"assert","path":"faction.ordered.convert:hive_resin","gte":1}
{"op":"assert","path":"faction.bodies","gte":12}
{"op":"screenshot","name":"hive_3days"}
{"op":"key","key":"O"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":30}
{"op":"click","target":"tab:factions"}
{"op":"screenshot","name":"factions_tab"}
