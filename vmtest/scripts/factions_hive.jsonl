{"name":"factions_hive","seed":777,"config":{"rivalsByCount":true}}
# The hive as a settlement (hive_plan.md, phase E2). New Expedition seed 777
# with Rival factions 3 (as factions_site): the brood lands on its landfall,
# Ashen Basin (sys_25), 207 fuel from the player's, so debug travel jumps
# there; the jump takes the star date to 69, so the brood has grown into a
# hive by arrival. Beam one colonist down and land:
# the presence is built as a settlement (the hive_core chamber laid with
# resin, the heart with grey eggs, pools with its biomass, the stage's
# clusters, chamber and spire, drones, scouts and warriors by type, coloured
# eggs). The stance is set neutral so its guards leave the landing party be
# while the frames are taken. Frames: the Star Map tag, the hive framed on
# its heart, the hive three days on (its director laying resin, foraging,
# laying eggs on the grey ones), and the Factions tab (morph names: hidden
# identity).
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Swarm"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"777"}
{"op":"click","target":"title:tutorial"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"debug","cmd":"see sys_25"}
{"op":"click","target":"row:locList:sys_25"}
{"op":"debug","cmd":"travel sys_25"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.location_id","eq":"sys_25"}
{"op":"assert","path":"campaign.day","gte":60}
{"op":"assert","path":"campaign.presences.sys_25","gte":12}
{"op":"assert","path":"selected_location.known_factions","eq":1}
{"op":"click","target":"dash:locateBtn"}
{"op":"wait","ticks":5}
{"op":"screenshot","name":"starmap"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"debug","cmd":"stance hive neutral"}
{"op":"assert","path":"faction.stage","eq":2}
{"op":"assert","path":"faction.launcher","eq":true}
{"op":"assert","path":"faction.bodies","gte":12}
{"op":"assert","path":"faction.units.drone","gte":1}
{"op":"assert","path":"faction.larvae","gte":1}
{"op":"assert","path":"faction.built.hive_heart","eq":1}
{"op":"assert","path":"faction.built.biomass_pool","gte":1}
{"op":"assert","path":"faction.built.egg_cluster","gte":1}
{"op":"assert","path":"faction.built.evolution_chamber","eq":1}
{"op":"debug","cmd":"faction walk"}
{"op":"wait","ticks":60}
{"op":"screenshot","name":"hive"}
