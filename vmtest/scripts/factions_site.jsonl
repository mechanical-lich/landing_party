{"name":"factions_site","seed":777,"config":{"rivalsByCount":true}}
# New Expedition seed 777 with Rival factions 3, then 36 days pass (debug
# days) so the brood on Rust Tangle (sys_43) grows into a hive. Jump there,
# beam one colonist down and land: the presence is built onto the level (the
# hive_core resin chamber, crawlers and fliers at its tier, eggs, the Resin
# Spire launcher). From orbit the hive is seen, and with it the egg it fired
# a few days earlier, drawn on the Star Map in flight toward its target.
# Frame the hive with debug faction walk and look.
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Infested"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"777"}
{"op":"click","target":"title:tutorial"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"debug","cmd":"days 36"}
{"op":"assert","path":"campaign.presences.sys_43","gte":12}
{"op":"click","target":"row:locList:sys_43"}
{"op":"click","target":"dash:travelBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.location_id","eq":"sys_43"}
{"op":"assert","path":"selected_location.known_factions","eq":1}
{"op":"assert","path":"campaign.known_fleets","gte":1}
{"op":"screenshot","name":"starmap"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"assert","path":"faction.stage","eq":2}
{"op":"assert","path":"faction.launcher","eq":true}
{"op":"assert","path":"faction.bodies","gte":12}
{"op":"assert","path":"faction.morphs.crawler","gte":1}
{"op":"assert","path":"faction.morphs.flier","gte":1}
{"op":"debug","cmd":"faction walk"}
{"op":"wait","ticks":20}
{"op":"assert","path":"view_room","eq":"Nest Heart"}
{"op":"screenshot","name":"hive"}
