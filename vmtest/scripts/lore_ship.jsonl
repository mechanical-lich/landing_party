{"name":"lore_ship","seed":11,"config":{"debugDisableLighting":true,"rivalsByCount":true}}
# A crashed warship: seed 11's start system is an earth_like world where an
# old warship came down (ancient_wreck, purpose warship). Walk to the wreck
# (debug origin walk ancient_wreck): its hull, sections and named rooms.
# Lighting is off so the whole wreck shows.
# Re-find with: make history-dump HFIND=start,ancient_wreck,purpose=warship,stamped:ancient_wreck
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Lore Ship"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"11"}
{"op":"click","target":"title:tutorial"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"click","target":"row:locList:start"}
{"op":"assert","path":"selected_location.history_summary","eq":true}
{"op":"click","target":"dash:travelBtn"}
