{"name":"galaxy","seed":777,"config":{"rivalsByCount":true}}
# The pregenerated galaxy (pregenerated_galaxy_plan.md steps 1-2 and sight):
# a new run's Star Map at each size and three shapes (seed 1 small irregular,
# seed 2 medium ring, seed 5 large spiral), each with only its landfall system
# identified, the few systems within sight of the landfall dim points, and
# the rest of the galaxy only the faint haze of its shape. On the medium run
# two blind jumps each see what lies within sight of where they arrive, and a
# scan identifies the systems in range (its circle drawn while Scan is
# hovered).
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Small"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"1"}
{"op":"click","target":"title:tutorial"}
{"op":"assert","path":"title_fields.size","eq":"medium"}
{"op":"click","target":"title:size_prev"}
{"op":"assert","path":"title_fields.size","eq":"small"}
{"op":"screenshot","name":"title_small"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":240}
{"op":"assert","path":"campaign.galaxy_size","eq":"small"}
{"op":"assert","path":"campaign.galaxy_shape","eq":"irregular"}
{"op":"assert","path":"campaign.systems","eq":41}
{"op":"assert","path":"campaign.identified","eq":1}
{"op":"assert","path":"campaign.seen","eq":9}
{"op":"assert","path":"campaign.gate_identified","eq":false}
{"op":"wait","ticks":5}
{"op":"screenshot","name":"small_irregular"}
# Zoomed out: the haze reads as the galaxy's shape.
{"op":"move","at":[576,335]}
{"op":"scroll","dx":0,"dy":-1}
