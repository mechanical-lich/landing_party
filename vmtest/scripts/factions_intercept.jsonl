{"name":"factions_intercept","seed":55,"config":{"rivalsByCount":true}}
# New Expedition seed 55 with Rival factions 3: the greyish mothership (fl2)
# is parked in orbit of the greys' landfall, Scorch Reach (sys_26, on the
# rim, 83 fuel from the Wreck Site: a 28-day jump, so their scout has moved
# on by arrival). Jump there: arriving under it is an interception. The Contact popup stops
# the clock and offers Evade (8 fuel, a mothership's) and Board; no Parley,
# the greys are hostile. Board: the mothership's deck is built as an
# encounter location (a docking deck in open space, the hull beside it, ten
# greys aboard and its hoard in a locker) and the ship goes into orbit of
# it; the Star Map draws the mothership over Scorch Reach. Beam a colonist
# aboard and look.
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Contact"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"55"}
{"op":"click","target":"title:tutorial"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"assert","path":"campaign.ship_fleets.fl2.mothership","eq":true}
{"op":"assert","path":"campaign.encounter","eq":null}
{"op":"debug","cmd":"see sys_26"}
{"op":"click","target":"row:locList:sys_26"}
{"op":"click","target":"dash:travelBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.location_id","eq":"sys_26"}
{"op":"assert","path":"campaign.encounter.pending","eq":true}
{"op":"assert","path":"campaign.encounter.at","eq":"orbit"}
{"op":"assert","path":"modal","eq":["encounter"]}
{"op":"screenshot","name":"contact"}
{"op":"click","target":"popup:board"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.encounter.outcome","eq":"boarded"}
{"op":"assert","path":"campaign.ship_fleets.fl2.boarded","eq":"enc1"}
{"op":"assert","path":"campaign.location_id","eq":"enc1"}
{"op":"click","target":"btn:dashboard"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":60}
{"op":"click","target":"row:locList:sys_26"}
{"op":"wait","ticks":2}
{"op":"screenshot","name":"mothership"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"debug","cmd":"boarding walk"}
{"op":"wait","ticks":10}
{"op":"screenshot","name":"deck"}
