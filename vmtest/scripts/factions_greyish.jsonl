{"name":"factions_greyish","seed":55,"config":{"rivalsByCount":true}}
# New Expedition seed 55 with Rival factions 3: a hive, a rival colony and
# the greyish, whose scout (fl1) is seeded landed on Ember Pit (sys_20, 10
# fuel from the Wreck Site) and whose mothership (fl2) is parked in orbit of
# Verdant Hold (sys_14), far from Home. Jump to Ember Pit: from orbit the
# scout is seen, drawn on the Star Map as a saucer beside the site, tagged
# GREY SCOUT · HOSTILE. Beam one colonist down and land: the greys' landed
# saucer is built onto the level (the stamped hull, a locker of their own
# with the hold, the scout's modules: a grey vat and a console; phase E4)
# and three typed grey crew work it. Let the
# director print and mine a while, then frame the camp and look.
{"op":"wait","ticks":10}
{"op":"click","target":"title:new"}
{"op":"click","target":"title:name"}
{"op":"type","text":"Greys"}
{"op":"click","target":"title:seed"}
{"op":"type","text":"55"}
{"op":"click","target":"title:tutorial"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:factions_plus"}
{"op":"click","target":"title:launch"}
{"op":"wait_until","path":"state","eq":"dashboard","max_ticks":120}
{"op":"assert","path":"campaign.faction_count","eq":3}
{"op":"assert","path":"campaign.ship_fleets.fl1.doctrine","eq":"greyish"}
{"op":"assert","path":"campaign.ship_fleets.fl1.landed","eq":"sys_20"}
{"op":"assert","path":"campaign.ship_fleets.fl2.mothership","eq":true}
{"op":"assert","path":"campaign.ship_fleets.fl2.to","eq":"sys_14"}
{"op":"assert","path":"campaign.diplomacy.greyish","eq":"hostile"}
{"op":"click","target":"row:locList:sys_20"}
{"op":"click","target":"dash:travelBtn"}
{"op":"wait","ticks":5}
{"op":"assert","path":"campaign.location_id","eq":"sys_20"}
{"op":"assert","path":"campaign.ship_fleets.fl1.known","eq":true}
{"op":"assert","path":"modal","eq":[]}
{"op":"screenshot","name":"starmap"}
{"op":"click","target":"row:shipList:0"}
{"op":"click","target":"dash:beamDownBtn"}
{"op":"wait","ticks":5}
{"op":"click","target":"dash:returnSiteBtn"}
{"op":"wait_until","path":"state","eq":"site","max_ticks":60}
{"op":"assert","path":"rival.workers","eq":3}
{"op":"assert","path":"rival.built.grey_vat","eq":1}
{"op":"assert","path":"rival.built.grey_console","eq":1}
{"op":"wait","ticks":900}
{"op":"debug","cmd":"rival walk"}
{"op":"wait","ticks":20}
{"op":"screenshot","name":"camp"}
